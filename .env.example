# AgriSync Environment Configuration Template
# Salin file ini menjadi `.env` untuk penggunaan lokal (jangan commit file .env ke Git)

# Application Environment
APP_ENV=development
APP_DEBUG=true

# Backend API Configuration
API_BASE_URL=https://api.agrisync.id/v1
API_TIMEOUT_MS=15000

# Payment Gateway Sandbox (Midtrans / Xendit Sandbox)
PAYMENT_GATEWAY_PROVIDER=midtrans_sandbox
PAYMENT_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
PAYMENT_CLIENT_KEY=SB-Mid-client-yyyyyyyyyyyy
PAYMENT_COMMISSION_PERCENT=2.5

# Cloud & Notification Services
FIREBASE_PROJECT_ID=agrisync-innovation-dev
STORAGE_BUCKET=agrisync-assets.appspot.com

# Map & Geospatial Configuration (OpenStreetMap / Custom Provider)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_API_KEY=

